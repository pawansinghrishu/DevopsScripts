 vi apache-tomcat-11.0.13/conf/tomcat-users.xml

<?xml version="1.0" encoding="UTF-8"?>
<tomcat-users xmlns="http://tomcat.apache.org/xml"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://tomcat.apache.org/xml tomcat-users.xsd"
              version="1.0">

  <!-- Define roles required for the Tomcat Manager application -->
  <role rolename="manager-gui"/>
  <role rolename="manager-script"/>
  <role rolename="manager-jmx"/>
  <role rolename="manager-status"/>

  <!-- Define a user with all manager roles -->
  <user username="tomcat" password="root123" roles="manager-gui,manager-script,manager-jmx,manager-status"/>

</tomcat-users>


# Stop Tomcat (if running)
sh apache-tomcat-11.0.13/bin/shutdown.sh

# Start Tomcat
sh apache-tomcat-11.0.13/bin/startup.sh
